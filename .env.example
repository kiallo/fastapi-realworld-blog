# 复制此文件为 .env 并填入真实值
APP_ENV=dev
DATABASE_URL=postgresql://postgres:你的密码@localhost:5432/postgres
SECRET_KEY=替换为一个随机字符串

# Redis（会话白名单用）
# ⚠️ 本地开发必须写 127.0.0.1，不要用 localhost：
#    Windows 上 localhost 会先解析到 ::1，而 docker-compose.override.yml
#    只把 Redis 绑在 127.0.0.1；IPv6 连接会一直挂到超时，
#    现象是「登录返回 200，但之后所有需要认证的接口都提示会话已失效」。
# ⚠️ 在 docker-compose 的 app 服务里由 environment 覆盖为服务名 redis。
REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=

# ===== LLM =====
# 复制到 .env 后填真实 key；不要把 .env 提交
LLM_API_KEY=替换为你的 key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=20
LLM_MAX_INPUT_CHARS=6000